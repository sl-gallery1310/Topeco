# ---------------------------------------------------------------------------
# Base de données MySQL 8
# Correspond à docker-compose.yml. Port 3308 côté hôte : un mysqld local
# occupe déjà 3306 sur cette machine.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://topeco:topeco@localhost:3308/topeco"

# Utilisées uniquement par `npm run db:dump`
DB_USER="topeco"
DB_PASSWORD="topeco"
DB_NAME="topeco"

# ---------------------------------------------------------------------------
# Session / auth (cookie httpOnly + table Session)
# Générer : openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET="remplacer-par-32-octets-aleatoires"
SESSION_COOKIE_NAME="topeco_session"

# ---------------------------------------------------------------------------
# URL publique (sitemap, métadonnées Open Graph)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# E-mail (formulaires RDV / SAV / candidature revendeur)
# Sans SMTP_HOST + SMTP_USER, les messages sont journalisés au lieu d'être
# envoyés : les formulaires restent testables en local.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TOPECO <no-reply@topeco.fr>"
MAIL_TO_SALES="commercial@topeco.fr"
MAIL_TO_SUPPORT="contact@topeco.fr"
MAIL_TO_NETWORK="reseau@topeco.fr"

# ---------------------------------------------------------------------------
# Mode projet étudiant
# true  = affiche « projet étudiant fictif : aucun achat... » et bloque le tunnel
# false = site réel (retire les avertissements, active le panier)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE="true"

# ---------------------------------------------------------------------------
# Upload d'images (back-office) — local = /public/uploads
# ---------------------------------------------------------------------------
UPLOAD_DRIVER="local"
UPLOAD_DIR="./public/uploads"
