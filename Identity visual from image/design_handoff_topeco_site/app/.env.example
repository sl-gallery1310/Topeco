# ---- Base de données MySQL ----
# Local (MAMP/XAMPP/Docker) ou hébergement mutualisé type OVH/Hostinger/PlanetScale
DATABASE_URL="mysql://topeco:topeco@127.0.0.1:3306/topeco"

# Variables utilisées uniquement par le script npm run db:dump
DB_USER="topeco"
DB_PASSWORD="topeco"
DB_NAME="topeco"

# ---- Session / auth ----
# openssl rand -base64 32
SESSION_SECRET="remplacer-par-32-octets-aleatoires"
SESSION_COOKIE_NAME="topeco_session"

# ---- URL publique ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- E-mail (formulaires RDV / SAV / candidature revendeur) ----
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TOPECO <no-reply@topeco.fr>"
MAIL_TO_SALES="commercial@topeco.fr"
MAIL_TO_SUPPORT="contact@topeco.fr"
MAIL_TO_NETWORK="reseau@topeco.fr"

# ---- Mode projet étudiant ----
# true  = affiche partout « projet étudiant fictif : aucun achat... » et bloque le checkout
# false = site réel (retire les avertissements, active le panier)
NEXT_PUBLIC_DEMO_MODE="true"

# ---- Upload d'images (back-office) ----
# local = /public/uploads ; s3 = à implémenter si besoin
UPLOAD_DRIVER="local"
UPLOAD_DIR="./public/uploads"
