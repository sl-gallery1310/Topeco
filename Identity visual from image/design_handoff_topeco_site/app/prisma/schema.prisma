// TOPECO — schéma Prisma / MySQL 8
// Argent : toujours stocké HT en centimes (Int). Le TTC est dérivé (voir src/lib/pricing.ts).
// Textes : fr-FR, apostrophe typographique ’ conservée telle quelle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ CATALOGUE */

model Category {
  id                   Int       @id @default(autoincrement())
  slug                 String    @unique @db.VarChar(80)
  name                 String    @db.VarChar(160)
  shortDescription     String    @db.VarChar(255)
  introHtml            String    @db.Text
  longDescriptionHtml  String?   @db.Text
  regulatoryNoteHtml   String?   @db.Text
  regulatoryArticleId  Int?
  imageUrl             String?   @db.VarChar(255)
  imageAlt             String?   @db.VarChar(255)
  placeholderLabel     String?   @db.VarChar(80) // « VISUEL HYGIÈNE À VENIR »
  sortOrder            Int       @default(0)
  published            Boolean   @default(true)
  seoTitle             String?   @db.VarChar(200)
  seoDescription       String?   @db.VarChar(320)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products             Product[]
  regulatoryArticle    Article?  @relation("CategoryRegulatoryArticle", fields: [regulatoryArticleId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
}

enum Material {
  FIBRE_MOULEE
  CARTON_CERTIFIE
  KRAFT_BRUT
  PET_RECYCLE
  INOX
  AUTRE
}

enum AgecStatus {
  CONFORME
  A_SURVEILLER
  A_REMPLACER
}

enum StockStatus {
  EN_STOCK
  SUR_COMMANDE
  EPUISE
  ARRETE
}

model Product {
  id                   Int          @id @default(autoincrement())
  sku                  String       @unique @db.VarChar(40)   // TPE-INX-050
  slug                 String       @unique @db.VarChar(120)
  categoryId           Int
  name                 String       @db.VarChar(200)
  lotLabel             String?      @db.VarChar(160)          // « Lot de 300 · avec couvercle »
  specLine             String?      @db.VarChar(200)          // « inox 18/8 · 21,5 cm · goupillon inclus »
  descriptionHtml      String?      @db.Text
  bullets              Json?                                   // string[]
  basePriceHt          Int                                     // centimes
  vatRate              Decimal      @default(0.20) @db.Decimal(4, 3)
  material             Material?
  capacityMl           Int?
  sampleAvailable      Boolean      @default(false)
  lifetimeWarranty     Boolean      @default(false)
  recyclabilityUrl     String?      @db.VarChar(255)
  recyclabilitySize    Int?                                    // octets, affiché « (PDF, 180 ko) »
  agecStatus           AgecStatus   @default(CONFORME)
  agecDeadline         DateTime?
  replacementProductId Int?
  stockStatus          StockStatus  @default(EN_STOCK)
  published            Boolean      @default(true)
  sortOrder            Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  category             Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  replacement          Product?     @relation("Replacement", fields: [replacementProductId], references: [id], onDelete: SetNull)
  replacedBy           Product[]    @relation("Replacement")
  images               ProductImage[]
  priceTiers           PriceTier[]
  resellerStocks       ResellerStock[]
  orderLines           OrderLine[]
  quoteLines           QuoteLine[]
  cartLines            CartLine[]

  @@index([categoryId, published])
  @@index([material])
  @@index([agecStatus])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String  @db.VarChar(255)
  alt       String  @db.VarChar(255)
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Paliers dégressifs. maxQty NULL = « 25 et plus ».
model PriceTier {
  id          Int     @id @default(autoincrement())
  productId   Int
  minQty      Int
  maxQty      Int?
  unitPriceHt Int

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@index([productId])
}

/* ------------------------------------------------------------------ RÉSEAU */

enum ResellerType {
  DIRECT
  PARTNER
}

enum ResellerStatus {
  ACTIVE
  PROSPECTING
  AVAILABLE
}

model Reseller {
  id                Int             @id @default(autoincrement())
  companyName       String          @db.VarChar(160)
  type              ResellerType    @default(PARTNER)
  status            ResellerStatus  @default(ACTIVE)
  regionLabel       String          @db.VarChar(160)  // « Hauts-de-France · Grand Est »
  regionCodes       Json?                              // ["32","44"]
  city              String?         @db.VarChar(120)
  postcode          String?         @db.VarChar(10)
  address           String?         @db.VarChar(255)
  lat               Decimal?        @db.Decimal(9, 6)
  lng               Decimal?        @db.Decimal(9, 6)
  phone             String?         @db.VarChar(30)
  pickupPointCount  Int             @default(0)
  ctaLabel          String?         @db.VarChar(80)   // « Commander en ligne » / « Territoire disponible »
  ctaHref           String?         @db.VarChar(200)
  sortOrder         Int             @default(0)
  published         Boolean         @default(true)

  stocks            ResellerStock[]
  territory         Territory?

  @@index([postcode])
  @@index([status])
}

model ResellerStock {
  resellerId Int
  productId  Int

  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([resellerId, productId])
}

enum TerritoryStatus {
  TAKEN
  PROSPECTING
  AVAILABLE
}

model Territory {
  id                 Int              @id @default(autoincrement())
  regionName         String           @unique @db.VarChar(120)
  status             TerritoryStatus  @default(AVAILABLE)
  assignedResellerId Int?             @unique

  assignedReseller   Reseller?        @relation(fields: [assignedResellerId], references: [id], onDelete: SetNull)
  applications       ResellerApplication[]
}

enum RevenueBand {
  UNDER_500K
  BETWEEN_500K_2M
  OVER_2M
}

enum ApplicationStatus {
  NEW
  QUALIFYING
  ACCEPTED
  REJECTED
}

model ResellerApplication {
  id                Int                @id @default(autoincrement())
  companyName       String             @db.VarChar(160)
  siret             String             @db.VarChar(14)
  contactName       String             @db.VarChar(160)
  email             String             @db.VarChar(190)
  territoryId       Int
  annualRevenueBand RevenueBand?
  clientsAndVolumes String?            @db.Text
  status            ApplicationStatus  @default(NEW)
  internalNote      String?            @db.Text
  createdAt         DateTime           @default(now())

  territory         Territory          @relation(fields: [territoryId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

/* ------------------------------------------------------------------ ÉDITORIAL */

model ArticleCategory {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(60)   // loi-agec | materiaux | temoignages
  name      String    @db.VarChar(120)          // « Loi AGEC »
  sortOrder Int       @default(0)

  articles  Article[]
}

model Article {
  id                Int              @id @default(autoincrement())
  slug              String           @unique @db.VarChar(160)
  title             String           @db.VarChar(240)
  dek               String           @db.VarChar(400)
  eyebrow           String?          @db.VarChar(80)   // « À LA UNE · LOI AGEC »
  categoryId        Int
  bodyBlocks        Json                              // voir src/lib/blocks.ts
  heroImageUrl      String?          @db.VarChar(255)
  heroImageAlt      String?          @db.VarChar(255)
  disclaimerText    String?          @db.Text
  relatedCategoryId Int?
  featured          Boolean          @default(false)
  published         Boolean          @default(false)
  publishedAt       DateTime?
  updatedAt         DateTime         @updatedAt
  seoTitle          String?          @db.VarChar(200)
  seoDescription    String?          @db.VarChar(320)

  category          ArticleCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  usedAsRegulatoryNoteBy Category[]  @relation("CategoryRegulatoryArticle")

  @@index([published, publishedAt])
  @@index([featured])
}

/// Pages de contenu libre : /nos-engagements, /mentions-legales, /cgv, /cgu, /confidentialite, /accessibilite, /plan-du-site
model Page {
  id             Int      @id @default(autoincrement())
  slug           String   @unique @db.VarChar(120)
  title          String   @db.VarChar(200)
  introHtml      String?  @db.Text
  bodyBlocks     Json
  published      Boolean  @default(true)
  seoTitle       String?  @db.VarChar(200)
  seoDescription String?  @db.VarChar(320)
  updatedAt      DateTime @updatedAt
}

/* ------------------------------------------------------------------ COMPTES / AUTH */

enum UserRole {
  ADMIN
  EDITOR
  CLIENT
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(190)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(160)
  role         UserRole  @default(CLIENT)
  accountId    Int?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  sessions     Session[]
  resetTokens  PasswordResetToken[]

  @@index([accountId])
}

model Session {
  id        String   @id @db.VarChar(64)   // token aléatoire, stocké en cookie httpOnly
  userId    Int
  expiresAt DateTime
  userAgent String?  @db.VarChar(255)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Compte professionnel (client B2B) — porte la remise contractuelle.
model Account {
  id                  Int       @id @default(autoincrement())
  accountNumber        String   @unique @db.VarChar(20)  // « 10428 »
  companyName          String   @db.VarChar(190)
  contactName          String?  @db.VarChar(160)
  email                String   @db.VarChar(190)
  phone                String?  @db.VarChar(30)
  siret                String?  @db.VarChar(14)
  billingAddress       String?  @db.Text
  shippingAddress      String?  @db.Text
  contractDiscountPct  Decimal  @default(0) @db.Decimal(5, 2)  // 12.00
  creditLimitHt        Int      @default(0)                    // centimes : 150000 = 1 500 € HT
  paymentTerms         String?  @db.VarChar(120)               // « 30 jours fin de mois »
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  orders               Order[]
  quotes               Quote[]
  carts                Cart[]
}

/* ------------------------------------------------------------------ COMMERCE */

enum OrderStatus {
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  FACTURE_A_REGLER
  ANNULEE
}

model Order {
  id             Int         @id @default(autoincrement())
  reference      String      @unique @db.VarChar(20)  // CMD-26-0412
  accountId      Int
  placedAt       DateTime    @default(now())
  status         OrderStatus @default(EN_PREPARATION)
  totalHt        Int
  vatAmount      Int
  totalTtc       Int
  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  invoiceUrl     String?     @db.VarChar(255)
  deliveryMethod String?     @db.VarChar(80)   // « Livraison directe 48 h » / « Retrait entrepôt »
  deliveryDate   DateTime?
  internalNote   String?     @db.Text

  account        Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines          OrderLine[]

  @@index([accountId, placedAt])
  @@index([status])
}

model OrderLine {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int?
  sku         String  @db.VarChar(40)   // figé à la commande
  name        String  @db.VarChar(200)  // figé à la commande
  qty         Int
  unitPriceHt Int
  lineTotalHt Int

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum QuoteStatus {
  EN_COURS
  ACCEPTE
  EXPIRE
  REFUSE
}

model Quote {
  id         Int         @id @default(autoincrement())
  reference  String      @unique @db.VarChar(20)  // DEV-26-0091
  accountId  Int
  label      String      @db.VarChar(200)         // « remplacement couverts »
  validUntil DateTime
  status     QuoteStatus @default(EN_COURS)
  totalHt    Int
  totalTtc   Int
  pdfUrl     String?     @db.VarChar(255)
  createdAt  DateTime    @default(now())
  acceptedAt DateTime?
  orderId    Int?        @unique                  // rempli à l’acceptation

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines      QuoteLine[]

  @@index([accountId, status])
}

model QuoteLine {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  productId   Int?
  sku         String   @db.VarChar(40)
  name        String   @db.VarChar(200)
  qty         Int
  unitPriceHt Int
  lineTotalHt Int

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/// Panier (écran non designé — voir README « écrans à concevoir »)
model Cart {
  id         String     @id @db.VarChar(36)  // uuid, cookie anonyme ou lié au compte
  accountId  Int?
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lines      CartLine[]
}

model CartLine {
  id                  Int     @id @default(autoincrement())
  cartId              String  @db.VarChar(36)
  productId           Int
  qty                 Int
  resolvedUnitPriceHt Int

  cart                Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

/* ------------------------------------------------------------------ FORMULAIRES */

enum AppointmentFormat {
  TELEPHONE
  VISITE
  VISIO
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

/// Créneaux réels, gérés au back-office (remplace les 4 créneaux figés du prototype).
model AppointmentSlot {
  id           Int           @id @default(autoincrement())
  startsAt     DateTime
  endsAt       DateTime
  label        String        @db.VarChar(80)   // « Mardi 10 h – 10 h 30 »
  capacity     Int           @default(1)
  bookedCount  Int           @default(0)
  published    Boolean       @default(true)

  appointments Appointment[]

  @@index([startsAt, published])
}

model Appointment {
  id            Int                @id @default(autoincrement())
  slotId        Int?
  slotLabel     String             @db.VarChar(80)  // figé à la demande
  companyName   String             @db.VarChar(190)
  managerName   String             @db.VarChar(160)
  phone         String             @db.VarChar(30)
  email         String             @db.VarChar(190)
  format        AppointmentFormat  @default(TELEPHONE)
  department    String             @db.VarChar(3)
  needsText     String?            @db.Text
  consentGiven  Boolean            @default(false)
  consentAt     DateTime?
  status        AppointmentStatus  @default(REQUESTED)
  internalNote  String?            @db.Text
  createdAt     DateTime           @default(now())

  slot          AppointmentSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum SupportSubject {
  SUIVI_COMMANDE
  FACTURE_DEVIS
  PRODUIT_DEFECTUEUX
  FICHE_TECHNIQUE
  AUTRE
}

enum SupportStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

model SupportRequest {
  id             Int             @id @default(autoincrement())
  subject        SupportSubject
  orderReference String?         @db.VarChar(20)
  email          String          @db.VarChar(190)
  message        String          @db.Text
  status         SupportStatus   @default(NEW)
  internalNote   String?         @db.Text
  createdAt      DateTime        @default(now())
  answeredAt     DateTime?

  @@index([status, createdAt])
}

/// Recherche revendeur / produit : sert à mesurer les zones non couvertes.
model DealerSearch {
  id        Int      @id @default(autoincrement())
  query     String   @db.VarChar(120)
  productId Int?
  results   Int      @default(0)
  createdAt DateTime @default(now())
}

/* ------------------------------------------------------------------ RÉGLEMENTAIRE */

model RegulatoryDeadline {
  id                 Int      @id @default(autoincrement())
  label              String   @db.VarChar(200)
  effectiveOn        DateTime
  descriptionHtml    String?  @db.Text
  affectedMaterials  Json?    // Material[]
  affectedSkus       Json?    // string[]
  articleId          Int?
  active             Boolean  @default(true)

  @@index([effectiveOn, active])
}

/* ------------------------------------------------------------------ RGPD */

model CookieConsent {
  id              String   @id @db.VarChar(36)  // uuid anonyme (cookie)
  userId          Int?
  necessary       Boolean  @default(true)
  analytics       Boolean  @default(false)
  personalisation Boolean  @default(false)
  policyVersion   String   @db.VarChar(20)
  decidedAt       DateTime @default(now())
  ip              String?  @db.VarChar(45)

  @@index([decidedAt])
}

/// Journal des actions back-office (exigence « traçabilité » du dossier étudiant).
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(60)   // create | update | delete | login | status-change
  entity    String   @db.VarChar(60)   // Product | Order | Article...
  entityId  String?  @db.VarChar(40)
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Paramètres éditables au back-office (téléphone, horaires, e-mails, bandeau démo).
model Setting {
  key       String   @id @db.VarChar(60)
  value     String   @db.Text
  label     String   @db.VarChar(160)
  group     String   @db.VarChar(40)   // contact | seo | legal | demo
  updatedAt DateTime @updatedAt
}
